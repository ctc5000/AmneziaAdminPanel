# Copy this file to ".env" and adjust the values.
# The server reads it automatically on startup (via dotenv).

# HTTP port the control panel listens on. Defaults to 3000 if not set.
PORT=3600

# Initial administrator account, created on the first start only
# (when the users file does not exist yet). If you leave these unset,
# the panel bootstraps "admin" / "admin" — change the password right away
# via the "Users" dialog after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
